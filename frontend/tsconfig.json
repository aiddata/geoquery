{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"rewriteRelativeImportExtensions": true,
		"sourceMap": true,
		"strict": true,
		// $app/tsconfig limits ambient types to its own; keep bun:test types for the unit tests.
		"types": ["$app/types", "bun"]
	},
	"include": [
		"src",
		"vite.config.ts"
	]
}
